RewriteEngine On

# Serve static assets directly
RewriteCond %{REQUEST_URI} \.(css|js|png|jpg|jpeg|gif|ico|svg|webp|avif|woff2?|ttf|json|xml|txt|pdf)$ [NC,OR]
RewriteCond %{REQUEST_URI} ^/assets/
RewriteRule . - [L]

# Everything else → index.php (SSR SEO)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.php [L]